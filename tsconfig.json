{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@pocketshell/core": ["vendor/pocketshell-core/src/index.ts"],
      "@pocketshell/core/shared/*": ["vendor/pocketshell-core/src/shared/*"],
      "@pocketshell/core/attachments/*": ["vendor/pocketshell-core/src/attachments/*"],
      "@pocketshell/core/preview/*": ["vendor/pocketshell-core/src/preview/*"],
      "@ui/*": ["vendor/pocketshell-core/packages/ui/src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts", "vendor/pocketshell-core/src/**/*.ts", "vendor/pocketshell-core/packages/ui/src/*.ts"]
}
