{
  "name": "pocketshell-js-android",
  "private": true,
  "version": "0.6.0-dev",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "build:web": "pnpm verify:js-source && vue-tsc --noEmit && vite build",
    "verify:js-source": "node scripts/verify-js-source.mjs",
    "cap:sync": "cap sync android",
    "build:android:debug": "pnpm build:web && pnpm cap:sync && ./android/gradlew -p android assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.1.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "pinia": "2.3.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "8.1.0",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
